        """

rule extract_all_genomes_protein:
    input:
        "resources/all_genomes_protein{gtdb_version}.tar.gz"
    output:
        directory(r"resources/all_genomes_protein{gtdb_version,\d+}")
    shell:
        """
        mkdir {output}
        tar -xzf {input} -C {output} --strip-components=1
        """

