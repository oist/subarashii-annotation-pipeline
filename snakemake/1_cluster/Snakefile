            wget '{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}/ar_taxonomy_r{config[gtdb_version]}.tsv' -O {output}
            mv {output} {params.shared}/ar53_taxonomy_r{config[gtdb_version]}.tsv
            gzip {params.shared}/ar53_taxonomy_r{config[gtdb_version]}.tsv

        else
