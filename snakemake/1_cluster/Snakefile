    output:
        directory(r"resources/all_genomes_na{gtdb_version,\d+}")
    shell:
        """
        mkdir {output}
        tar -xzf {input} -C {output} --strip-components=1
        """

rule select_genomes_protein:
    input:
        get_accession_ids_file,
        "resources/all_genomes_protein{gtdbversion}".format(gtdbversion=config["gtdb_version"])
    output:
        directory("resources/{dataset}/selected_genomes_protein")
    shell:
        "scripts/select_genomes_protein.sh {input[0]} {input[1]} {output}"

rule select_genomes_na:
    input:
        get_accession_ids_file,
        "resources/all_genomes_na{gtdbversion}".format(gtdbversion=config["gtdb_version"])
    output:
        directory("resources/{dataset}/selected_genomes_na")
    shell:
        "scripts/select_genomes_na.sh {input[0]} {input[1]} {output}"

rule get_bacterial_taxonomy_file:
    output:
        "resources/bac120_taxonomy_r{}.tsv.gz".format(config["gtdb_version"])
    shell:
        """
        if curl -f '{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}/bac120_taxonomy_r{config[gtdb_version]}.tsv.gz' >/dev/null 2>&1; then
            wget '{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}/bac120_taxonomy_r{config[gtdb_version]}.tsv.gz' -O {output}

        elif curl -f '{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}/bac_taxonomy_r{config[gtdb_version]}.tsv.gz' >/dev/null 2>&1; then
            wget '{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}/bac_taxonomy_r{config[gtdb_version]}.tsv.gz' -O {output}

        elif curl -f '{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}/bac120_taxonomy_r{config[gtdb_version]}.tsv' >/dev/null 2>&1; then
            wget '{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}/bac120_taxonomy_r{config[gtdb_version]}.tsv' -O {output}
            mv {output} resources/bac120_taxonomy_r{config[gtdb_version]}.tsv
            gzip resources/bac120_taxonomy_r{config[gtdb_version]}.tsv

        elif curl -f '{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}/bac_taxonomy_r{config[gtdb_version]}.tsv'; then
            wget '{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}/bac_taxonomy_r{config[gtdb_version]}.tsv' -O {output}
            mv {output} resources/bac120_taxonomy_r{config[gtdb_version]}.tsv
            gzip resources/bac120_taxonomy_r{config[gtdb_version]}.tsv

        else
            echo "GTDB taxonomy file could not be found"
            exit -111
        fi
        """

