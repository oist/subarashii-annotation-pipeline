rule create_dataset_db:
    input:
        eggnog_annotations="results/{dataset}/eggnog/annotations.emapper.annotations",
        genome2abbrev="results/{dataset}/genome2abbrev.csv",
        fasta_dir="results/{dataset}/genomes_protein",
        na_dir="resources/{dataset}/selected_genomes_na",
        id_map="results/{dataset}/sequenceid_new2original.csv",
        bac_metadata="{}/bac120_metadata_r{}.tsv.gz".format(_SHARED, _VER),
        arc_metadata="{}/ar53_metadata_r{}.tsv.gz".format(_SHARED, _VER)
    output:
        genome_parquet="results/{dataset}/db/genome.parquet",
        protein_parquet="results/{dataset}/db/protein.parquet",
        protein_dna_parquet="results/{dataset}/db/protein_dna.parquet",
        duckdb="results/{dataset}/db/dataset.duckdb"
    resources:
        mem_mb_per_cpu=16000,
        runtime=480
    shell:
        """
        scripts/create_db.py \
            --genome2abbrev {input.genome2abbrev} \
            --eggnog {input.eggnog_annotations} \
            --fasta-dir {input.fasta_dir} \
            --na-dir {input.na_dir} \
            --id-map {input.id_map} \
            --bac-metadata {input.bac_metadata} \
            --arc-metadata {input.arc_metadata} \
            --output-dir results/{wildcards.dataset}/db \
            --duckdb {output.duckdb} \
            --max-ram-mb {resources.mem_mb_per_cpu} \
            --compression zstd
        """

rule flush_db_to_shared:
    """
    Flush the large protein parquet files from fast scratch to
    shared_data_dir and rewrite the DuckDB views to their new locations.

    Runs as a localrule (login node). No-op when shared_data_dir is null.

    After the flush:
      /scratch        — genome.parquet (KB), dataset.duckdb (KB, views -> shared)
      shared_data  — {dataset}/db/protein.parquet (GB), protein_dna.parquet (GB)
    """
    input:
        genome_parquet      = "results/{dataset}/db/genome.parquet",
        protein_parquet     = "results/{dataset}/db/protein.parquet",
        protein_dna_parquet = "results/{dataset}/db/protein_dna.parquet",
        duckdb              = "results/{dataset}/db/dataset.duckdb"
    output:
        touch("results/{dataset}/db/.flush_complete")
    run:
        import os, shutil, duckdb as _ddb
        from pathlib import Path

        shared = config.get("shared_data_dir")
        if not shared:
            print("[flush] shared_data_dir not set -- parquets stay on flash")
        else:
            dest = Path(shared) / wildcards.dataset / "db"
            dest.mkdir(parents=True, exist_ok=True)

            large_files = [input.protein_parquet, input.protein_dna_parquet]
            for src in large_files:
                dst = dest / Path(src).name
                print(f"[flush] {src} -> {dst}")
                shutil.copy2(src, dst)
                Path(src).unlink()

            # Rewrite DuckDB so its views point to the shared paths.
            # genome stays on flash (it's tiny), protein* are now on shared.
            genome_abs      = os.path.abspath(input.genome_parquet)
            protein_abs     = str(dest / "protein.parquet")
            protein_dna_abs = str(dest / "protein_dna.parquet")

            os.remove(input.duckdb)
            con = _ddb.connect(input.duckdb)
            con.execute(f"CREATE TABLE genome AS SELECT * FROM read_parquet('{genome_abs}')")
            con.execute(f"CREATE VIEW protein     AS SELECT * FROM read_parquet('{protein_abs}')")
            con.execute(f"CREATE VIEW protein_dna AS SELECT * FROM read_parquet('{protein_dna_abs}')")
            con.close()
            print(f"[flush] DuckDB rewritten with shared paths: {input.duckdb}")


rule db_all:
    input:
        "results/{}/db/.flush_complete".format(config["dataset"])
