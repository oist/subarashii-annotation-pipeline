        fi
        """

rule unzip_bacterial_taxonomy_file:
    input:
        "{}/bac120_taxonomy_r{}.tsv.gz".format(_SHARED, _VER)
    output:
        "{}/bac120_taxonomy_r{}.tsv".format(_SHARED, _VER)
    shell:
        "gzip -d {input}"

rule unzip_archaeal_taxonomy_file:
    input:
        "{}/ar53_taxonomy_r{}.tsv.gz".format(_SHARED, _VER)
    output:
        "{}/ar53_taxonomy_r{}.tsv".format(_SHARED, _VER)
    shell:
        "gzip -d {input}"

rule get_bacterial_metadata_file:
    output:
        "{}/bac120_metadata_r{}.tsv.gz".format(_SHARED, _VER)
    shell:
        """
        BASE='{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}'
        if curl -f "$BASE/bac120_metadata_r{config[gtdb_version]}.tsv.gz" >/dev/null 2>&1; then
            wget "$BASE/bac120_metadata_r{config[gtdb_version]}.tsv.gz" -O {output}
        elif curl -f "$BASE/bac120_metadata_r{config[gtdb_version]}.tar.gz" >/dev/null 2>&1; then
            wget "$BASE/bac120_metadata_r{config[gtdb_version]}.tar.gz" -O {output}.tar.gz
            tar -xzf {output}.tar.gz --wildcards '*.tsv' --strip-components=1 -O | gzip > {output}
            rm -f {output}.tar.gz
        elif curl -f "$BASE/bac_metadata_r{config[gtdb_version]}.tsv.gz" >/dev/null 2>&1; then
            wget "$BASE/bac_metadata_r{config[gtdb_version]}.tsv.gz" -O {output}
        else
            echo "GTDB bacterial metadata file could not be found"
            exit -111
        fi
        """

rule get_archaeal_metadata_file:
    output:
        "{}/ar53_metadata_r{}.tsv.gz".format(_SHARED, _VER)
    shell:
        """
        BASE='{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}'
        if curl -f "$BASE/ar53_metadata_r{config[gtdb_version]}.tsv.gz" >/dev/null 2>&1; then
            wget "$BASE/ar53_metadata_r{config[gtdb_version]}.tsv.gz" -O {output}
        elif curl -f "$BASE/ar53_metadata_r{config[gtdb_version]}.tar.gz" >/dev/null 2>&1; then
            wget "$BASE/ar53_metadata_r{config[gtdb_version]}.tar.gz" -O {output}.tar.gz
            tar -xzf {output}.tar.gz --wildcards '*.tsv' --strip-components=1 -O | gzip > {output}
            rm -f {output}.tar.gz
        elif curl -f "$BASE/ar_metadata_r{config[gtdb_version]}.tsv.gz" >/dev/null 2>&1; then
            wget "$BASE/ar_metadata_r{config[gtdb_version]}.tsv.gz" -O {output}
        elif curl -f "$BASE/ar122_metadata_r{config[gtdb_version]}.tsv.gz" >/dev/null 2>&1; then
            wget "$BASE/ar122_metadata_r{config[gtdb_version]}.tsv.gz" -O {output}
        else
            echo "GTDB archaeal metadata file could not be found"
            exit -111
        fi
        """

rule create_genome2taxa:
    input:
        get_accession_ids_file,
        "{}/bac120_taxonomy_r{}.tsv".format(_SHARED, _VER),
        "{}/ar53_taxonomy_r{}.tsv".format(_SHARED, _VER)
    output:
        "results/{dataset}/genome2taxa.csv"
    params:
        manual_taxa="resources/{}/{}".format(config["dataset"], config["manually_add_taxa_file"])
    shell:
        """
        #REGEXP=`tr '\\n' '|' < {input[0]} | sed 's/|$//'`
        #grep -E "$REGEXP" {input[1]} | sed -E 's/\\t+/,/g' > {output}
        #grep -E "$REGEXP" {input[2]} | sed -E 's/\\t+/,/g' >> {output}
        # the approach above doesn't work for big lists of accession IDs
        while read LINE; do
             RES=`grep "$LINE" {input[1]} || echo ""`
             if [ -z "$RES" ]; then
                 RES=`grep "$LINE" {input[2]} || echo ""`
             fi
             if [ ! -z "$RES" ]; then
                 echo "$RES" | sed -E 's/\\t+/,/g' >> {output}
             fi
        done < {input[0]}
        if [ -s "{params.manual_taxa}" ]; then
             echo "Appending contents of file {params.manual_taxa} to {output}"
             cat {params.manual_taxa} >> {output}
        else
             echo "{params.manual_taxa} not existing or empty"
        fi
        """

rule generate_shortcodes:
    input:
        "results/{dataset}/genome2taxa.csv"
    output:
        "results/{dataset}/genome2abbrev.csv"
    params:
        custom=lambda wildcards: config.get("custom_abbrev_map") or ""
    shell:
        """
        if [ -n "{params.custom}" ]; then
            cp {params.custom} {output}
        else
            scripts/rename_genomes.py {input} {output}
        fi
        """

rule rename_proteins:
    input:
        "results/{dataset}/genome2abbrev.csv",
        "resources/{dataset}/selected_genomes_protein"
    output:
        directory("results/{dataset}/genomes_protein"),
        "results/{dataset}/sequenceid_new2original.csv"
    shell:
        "scripts/rename_proteins.py --map {input[0]} --in {input[1]} --out {output[0]} -t {output[1]}"

rule cat_all_sequences:
    input:
        "results/{dataset}/genomes_protein"
    output:
        "results/{dataset}/all_genomes_protein.faa"
    shell:
        """
        #for f in {input}/*.faa; do
        #    cat $f >> {output}
        #done
        find {input}/ -iname "*.faa" -exec cat {{}} >> {output} \\;
        """

rule make_diamond_db:
    input:
        "results/{dataset}/all_genomes_protein.faa"
    output:
        "results/{dataset}/genomes_protein.dmnd"
    threads: config["diamond"]["threads"]
    shell:
        "diamond makedb --in {input} -d {output} --threads {threads}"

rule diamond_all_vs_all:
    input:
        db="results/{dataset}/genomes_protein.dmnd",
        query="results/{dataset}/all_genomes_protein.faa"
    output:
        "results/{dataset}/all_vs_all_wo_selfhits.tsv"
    resources:
        mem_mb_per_cpu=5000,
        # 1 day runtime
        runtime=1440
    threads: config["diamond"]["threads"]
    shell:
        """
        diamond blastp \
                --db     {input.db} \
                --query  {input.query} \
                --out    {output} \
                --outfmt 6 qseqid sseqid pident bitscore evalue qcovhsp scovhsp \
                --more-sensitive \
                --threads {threads}
        """

rule add_self_hits_to_diamond_all_vs_all:
    input:
        query="results/{dataset}/all_genomes_protein.faa",
        diamond="results/{dataset}/all_vs_all_wo_selfhits.tsv"
    output:
        "results/{dataset}/all_vs_all.tsv"
    shell:
        """
        cp {input.diamond} {output}
        # ---------- guarantee self-hits so singletons survive ----------
        # q s pident bits evalue qcov scov  (7 cols, tab-separated)
        awk '/^>/{{sub(/^>/,"",$0); printf "%s\\t%s\\t100\\t1000\\t1e-200\\t100\\t100\\n",$0,$0 }}' "{input.query}" >> "{output}"
        """


rule filter_and_convert_into_mcl_s_abc_format:
    input:
        "results/{dataset}/all_vs_all.tsv"
    output:
        "results/{dataset}/all_vs_all.abc"
    params:
        evalue_cut=config["diamond"]["evalue_cut"],
        cov_cut=config["diamond"]["cov_cut"]
    shell:
        "scripts/filter_and_convert.py -i {input} -o {output} -e {params.evalue_cut} -c {params.cov_cut}"

rule mcl_sweep:
    input:
        "results/{dataset}all_vs_all.abc"
    output:
        "results/{dataset}mcl_clusters_I{inflation}.txt"
    resources:
        mem_mb_per_cpu=config["mcl"]["memory"],
        runtime=config["mcl"]["runtime"]
    shell:
        "mcl {input} --abc -I {wildcards.inflation} -o {output}"

rule split_mcl_clusters:
    input:
        fasta="results/{dataset}/all_genomes_protein.faa",
        cluster="results/{dataset}/mcl_clusters_I{inflation}.txt"
    output:
        directory("results/{dataset}/mcl/{inflation}")
    params:
        huge_cutoff=_N_GENOMES * 5
    resources:
        mem_mb_per_cpu=_mem_mb(mb_per_genome=8),
        runtime=120
    shell:
        "scripts/split_clusters.py -f {input.fasta} -c {params.huge_cutoff} -m {input.cluster} -o {output}"

rule download_eggnog_diamond_database:
    output:
        "{}/eggnog_diamond_db/eggnog.db".format(_SHARED),
        "{}/eggnog_diamond_db/eggnog.db.fieldpresence.bin".format(_SHARED),
        "{}/eggnog_diamond_db/eggnog.db.taxids.bin".format(_SHARED),
        "{}/eggnog_diamond_db/eggnog_proteins.dmnd".format(_SHARED),
        "{}/eggnog_diamond_db/eggnog.taxa.db".format(_SHARED),
        "{}/eggnog_diamond_db/eggnog.taxa.db.traverse.pkl".format(_SHARED),
        "{}/eggnog_diamond_db/go-basic.obo".format(_SHARED)
    params:
        outdir="{}/eggnog_diamond_db".format(_SHARED)
    shell:
        """
        mkdir -p {params.outdir}
        # eggnog-mapper v3 beta bug: set_data_path() validates the default, hardcoded site-packages/data
        # directory before --data_dir is parsed. Create it so the check passes.
        python -c "import eggnogmapper, os; os.makedirs(os.path.join(os.path.dirname(eggnogmapper.__file__), '../data'), exist_ok=True)"
        download_eggnog_data.py -y -f --data_dir {params.outdir}
        """

# break into genomes and not all
rule eggnog_mapper:
    input:
        fasta="results/{dataset}/all_genomes_protein.faa",
        db="{}/eggnog_diamond_db/eggnog.db".format(_SHARED),
        fp="{}/eggnog_diamond_db/eggnog.db.fieldpresence.bin".format(_SHARED),
        taxids="{}/eggnog_diamond_db/eggnog.db.taxids.bin".format(_SHARED),
        dmnd="{}/eggnog_diamond_db/eggnog_proteins.dmnd".format(_SHARED),
        taxadb="{}/eggnog_diamond_db/eggnog.taxa.db".format(_SHARED),
        pkl="{}/eggnog_diamond_db/eggnog.taxa.db.traverse.pkl".format(_SHARED),
        go="{}/eggnog_diamond_db/go-basic.obo".format(_SHARED)
    output:
        "results/{dataset}/eggnog/annotations.emapper.annotations",
        "results/{dataset}/eggnog/annotations.emapper.hits",
        "results/{dataset}/eggnog/annotations.emapper.seed_orthologs",
    threads: config["eggnog"]["threads"]
    resources:
        mem_mb_per_cpu=4000,
        runtime=2880
    params:
        mode="diamond",
        outputprefix="results/{dataset}/eggnog/annotations",
        db="{}/eggnog_diamond_db".format(_SHARED)
    shell:
        """
        emapper.py -i {input.fasta} --itype proteins --cpu {threads} --data_dir {params.db} -m {params.mode} --output {params.outputprefix} --override
        """

rule cluster_into_cogs:
    input:
        eggnog_annotations="results/{dataset}/eggnog/annotations.emapper.annotations",
        fasta_dir="results/{dataset}/genomes_protein"
    output:
        directory("results/{dataset}/cog_clusters")
    params:
        huge_cutoff=_N_GENOMES * 5
    resources:
        mem_mb_per_cpu=_mem_mb(mb_per_genome=8),
        runtime=120
    shell:
        """
        scripts/create_cog_clusters.py -e {input.eggnog_annotations} -f {input.fasta_dir} -o {output} -c {params.huge_cutoff}
        """

rule create_eggnog_cog_counts_table:
    input:
        eggnog_annotations="results/{dataset}/eggnog/annotations.emapper.annotations",
        genome_to_abbrev="results/{dataset}/genome2abbrev.csv"
    output:
        "results/{dataset}/eggnog_cog_counts_table.csv"
    params:
        column_name_for_accession="accession",
        column_name_for_abbrev="short"
    shell:
        """
        scripts/generate_presence_absence_table.py -e {input.eggnog_annotations} -o {output} -m {input.genome_to_abbrev} --map-col-eggnog {params.column_name_for_abbrev} --map-col-output {params.column_name_for_accession}
        """

