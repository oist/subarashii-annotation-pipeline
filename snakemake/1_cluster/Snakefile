configfile: "config/config.yaml"

# All download / extract / unzip rules run as localrules, because:
#  (1) it doesn't need Slurm job
#  (2) if an HPC's cluster storages are split into writable and non-writable by a
#      a compute node, we want to stay on the node that has write permissions
localrules:
    flush_db_to_shared,
    get_all_genomes_protein,
    get_all_genomes_na,
    extract_all_genomes_protein,
    extract_all_genomes_na,
    get_bacterial_taxonomy_file,
    get_archaeal_taxonomy_file,
    unzip_bacterial_taxonomy_file,
    unzip_archaeal_taxonomy_file,
    get_bacterial_metadata_file,
    get_archaeal_metadata_file,
    download_eggnog_diamond_database

# Large GTDB reference files (archives, extracted dirs, taxonomy, metadata, eggnog DB)
# are stored under _SHARED.  Default is "resources/" -- fully backwards-compatible.
# On HPC cluster system: set shared_data_dir: /storage/user/project in config.yaml to write them
# directly to bulk storage, freeing fast /scratch.
_SHARED = config.get("shared_data_dir", "resources")
_VER    = str(config["gtdb_version"])
# "eggnog" (default): only COG clustering via EggNOG-mapper.
# "mcl": also run DIAMOND all-vs-all + MCL sweep for comparison.
_CLUSTERING = config.get("clustering", "eggnog")

# Genome count — read once at parse time so resource lambdas and params can use it.
# Falls back to 100 if the ID list doesn't exist yet (first dry-run before setup).
try:
    with open("resources/{}/{}".format(config["dataset"], config["accession_ids_file"])) as _f:
        _N_GENOMES = sum(1 for _l in _f if _l.strip())
except FileNotFoundError:
    _N_GENOMES = 100

def _mem_mb(mb_per_genome: int, base_mb: int = 2000):
    """Return a Snakemake resource lambda: scales with genome count, doubles on retry."""
    return lambda wildcards, attempt: max(base_mb, _N_GENOMES * mb_per_genome) * attempt

def get_accession_ids_file(wildcards):
    return "resources/{}/{}".format(wildcards.dataset, config["accession_ids_file"])

_STAGE1_TARGETS = [
    "{}/bac120_taxonomy_r{}.tsv".format(_SHARED, _VER),
    "resources/{}/selected_genomes_protein".format(config["dataset"]),
    "results/{}/genome2abbrev.csv".format(config["dataset"]),
    "results/{}/eggnog/annotations.emapper.annotations".format(config["dataset"]),
    "results/{}/cog_clusters".format(config["dataset"]),
    "results/{}/eggnog_cog_counts_table.csv".format(config["dataset"]),
]
if _CLUSTERING in ("mcl", "both"):
    _STAGE1_TARGETS += expand(
        "results/{dataset}/mcl_clusters_I{inf}.txt",
        dataset=config["dataset"], inf=config["mcl"]["inflation"],
    )
    _STAGE1_TARGETS += expand(
        "results/{dataset}/mcl/{inf}",
        dataset=config["dataset"], inf=config["mcl"]["inflation"],
    )

rule all:
    input: _STAGE1_TARGETS

rule get_all_genomes_protein:
    output:
        "{}/all_genomes_protein{}.tar.gz".format(_SHARED, _VER),
    shell:
        """
        if curl -f '{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}/genomic_files_reps/gtdb_proteins_aa_reps_r{config[gtdb_version]}.tar.gz' >/dev/null 2>&1; then
            wget '{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}/genomic_files_reps/gtdb_proteins_aa_reps_r{config[gtdb_version]}.tar.gz' -O {output}
        elif curl -f '{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}/gtdb_r{config[gtdb_version]}_rep_genomes.protein.faa.tar.gz' >/dev/null 2>&1; then
            wget '{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}/gtdb_r{config[gtdb_version]}_rep_genomes.protein.faa.tar.gz' -O {output}
        else
            echo "Proteomes not found on GTDB server"
            exit -111
        fi
        """

rule get_all_genomes_na:
    output:
        "{}/all_genomes_na{}.tar.gz".format(_SHARED, _VER)
    shell:
        """
        if curl -f '{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}/genomic_files_reps/gtdb_genomes_reps_r{config[gtdb_version]}.tar.gz' >/dev/null 2>&1; then
            wget '{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}/genomic_files_reps/gtdb_genomes_reps_r{config[gtdb_version]}.tar.gz' -O {output}
        elif curl -f '{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}/gtdb_r{config[gtdb_version]}.tar.gz' >/dev/null 2>&1; then
            wget '{config[gtdb_base_url]}release{config[gtdb_version]}/{config[gtdb_version]}.{config[gtdb_subversion]}/gtdb_r{config[gtdb_version]}.tar.gz' -O {output}
        else
            echo "Genomes not found on GTDB server"
            exit -111
        fi
        """

rule extract_all_genomes_protein:
    input:
        "{}/all_genomes_protein{}.tar.gz".format(_SHARED, _VER)
    output:
        directory("{}/all_genomes_protein{}".format(_SHARED, _VER))
    shell:
        """
        mkdir {output}
        tar -xzf {input} -C {output} --strip-components=1
        """

